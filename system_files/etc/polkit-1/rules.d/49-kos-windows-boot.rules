// K.OS: let the logged-in console user run ONE specific helper as administrator
// without a password. That helper can only do one thing: mark Windows as the
// next boot (one time). It cannot change anything else.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/kos-bootnext-windows" &&
        subject.local && subject.active &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
