#!/usr/bin/env bash
# K.OS on the Plasma desktop (developer desktop mode only).
# The console itself is the K.OS session (kos-start-session, kos-shell): it has
# no desktop at all. This script only runs when Plasma starts, and only
# refreshes the K.OS launchers and settings so they are also there on the desktop.
# To go back to the console: open "K.OS Home" from the app menu, log out,
# or restart. Desktop mode lasts for one login only.
set -uo pipefail

/usr/libexec/kos-firstboot-setup || true
exit 0
