#!/usr/bin/env bash
# K.OS "Switch to Windows" tile.
# Asks "Are you sure?", then restarts into Windows ONE time.
# Restarting from Windows afterwards comes back to K.OS automatically.
#
# Test without restarting:   kos-boot-windows --check
set -uo pipefail

EFIBOOTMGR=/usr/bin/efibootmgr
[ -x "${EFIBOOTMGR}" ] || EFIBOOTMGR=/usr/sbin/efibootmgr

# Messages: Turkish by default, English if the system language is English
case "${LANG:-}" in
    en*)
        T_TITLE="K.OS - Switch to Windows"
        T_QUESTION="Restart into Windows now?\n\nRestarting Windows later brings you back to K.OS."
        T_YES="Restart"
        T_NO="Cancel"
        T_NOTFOUND="Could not find Windows on this console."
        T_FAILED="Could not set Windows as the next start. Nothing was changed."
        ;;
    *)
        T_TITLE="K.OS - Windows'a Geç"
        T_QUESTION="Şimdi Windows ile yeniden başlatılsın mı?\n\nWindows'u yeniden başlattığınızda K.OS'a geri dönersiniz."
        T_YES="Yeniden Başlat"
        T_NO="Vazgeç"
        T_NOTFOUND="Bu konsolda Windows bulunamadı."
        T_FAILED="Windows bir sonraki açılış olarak ayarlanamadı. Hiçbir şey değiştirilmedi."
        ;;
esac

show_error() {
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "${T_TITLE}" --error "$1"
    elif command -v zenity >/dev/null 2>&1; then
        zenity --error --title="${T_TITLE}" --text="$1"
    fi
    echo "K.OS error: $1" >&2
}

ask_confirm() {
    local question
    question="$(printf '%b' "${T_QUESTION}")"
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "${T_TITLE}" --yes-label "${T_YES}" --no-label "${T_NO}" --yesno "${question}"
    elif command -v zenity >/dev/null 2>&1; then
        zenity --question --title="${T_TITLE}" --ok-label="${T_YES}" --cancel-label="${T_NO}" --text="${question}"
    else
        return 0
    fi
}

# Reading the boot list does not need administrator rights
WIN_BOOT_ID="$("${EFIBOOTMGR}" 2>/dev/null | grep -i "Windows Boot Manager" | head -n 1 | sed -E 's/^Boot([0-9A-Fa-f]{4}).*/\1/')"

if ! [[ "${WIN_BOOT_ID}" =~ ^[0-9A-Fa-f]{4}$ ]]; then
    show_error "${T_NOTFOUND}"
    exit 1
fi

if [ "${1:-}" = "--check" ]; then
    echo "OK: Windows Boot Manager found as Boot${WIN_BOOT_ID}. Nothing was changed."
    exit 0
fi

ask_confirm || exit 0

if ! pkexec /usr/libexec/kos-bootnext-windows >/dev/null; then
    show_error "${T_FAILED}"
    exit 1
fi

systemctl reboot
