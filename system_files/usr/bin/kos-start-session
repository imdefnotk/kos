#!/usr/bin/env bash
# K.OS session start. The login screen runs this when it starts the "K.OS"
# session (K.OS logs in automatically, so normally that is right after power on).
#
# What you see in the K.OS session:
#   no desktop, no taskbar, no Meta key menu. Only K.OS Home, and the games
#   and apps you open from it. Alt+Tab switches between them, Alt+F4 closes a
#   game (never K.OS Home). See /usr/libexec/kos-shortcuts. Under the hood it is
#   KWin (the KDE window manager) running with nothing but K.OS Home.
#
# Developer desktop mode (normal KDE Plasma desktop, main monitor only):
#   in K.OS Home choose Ayarlar > Sistem Bilgisi > Masaüstüne geç,
#   or create the empty file ~/.config/kos-desktop-mode (for example from a
#   text console: Ctrl+Alt+F3, log in, run: touch ~/.config/kos-desktop-mode
#   then: systemctl reboot).
#   To come back to the console, open "K.OS Home" from the app menu.
#
# Safety net: if the K.OS session fails to start 3 times in a row, this
# login opens the normal Plasma desktop instead, so the PC is never stuck.
# Log: ~/.local/state/kos/session.log
set -u

MARK="${HOME}/.config/kos-desktop-mode"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/kos"
FAILS_FILE="${STATE_DIR}/session-fails"
LOG="${STATE_DIR}/session.log"
mkdir -p "${STATE_DIR}"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "${LOG}"
}

# Keep the log small
if [ -f "${LOG}" ] && [ "$(stat -c %s "${LOG}" 2>/dev/null || echo 0)" -gt 1000000 ]; then
    mv -f "${LOG}" "${LOG}.old"
fi

# The K.OS session hands its screen address (WAYLAND_DISPLAY, DISPLAY) and
# KOS_SESSION to the user's background services. Those must never outlive it:
# Plasma started with an old WAYLAND_DISPLAY tries to run inside a screen that
# is gone and fails (black screen). So every start begins clean.
clean_env() {
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY KOS_SESSION >/dev/null 2>&1 || true
    unset WAYLAND_DISPLAY DISPLAY KOS_SESSION
}
clean_env

PLASMA_STARTS="${STATE_DIR}/plasma-starts"

# A desktop (KWin, Plasma) left over from the previous login must be gone
# before a new one starts. Two at once fight over the screen and keyboard:
# black monitor, Alt+Tab dead (the old one keeps the shortcut service
# org.kde.kglobalaccel), slow games. Nothing of this login is running yet,
# so everything found here is left over.
stop_leftovers() {
    local uid n
    uid="$(id -u)"
    systemctl --user stop plasma-workspace.target plasma-core.target >/dev/null 2>&1 || true
    systemctl --user stop plasma-kwin_wayland.service plasma-plasmashell.service \
        plasma-ksmserver.service plasma-kglobalaccel.service >/dev/null 2>&1 || true
    for n in $(seq 1 20); do
        pgrep -u "${uid}" -x 'kwin_wayland|plasmashell|ksmserver|kglobalacceld' >/dev/null 2>&1 || break
        [ "${n}" -eq 10 ] && pkill -TERM -u "${uid}" -x 'kwin_wayland|kwin_wayland_wr|plasmashell|ksmserver|kglobalacceld' >/dev/null 2>&1
        sleep 0.5
    done
    if pgrep -u "${uid}" -x 'kwin_wayland|plasmashell|ksmserver|kglobalacceld' >/dev/null 2>&1; then
        log "leftover desktop still running, forcing it to close"
        pkill -KILL -u "${uid}" -x 'kwin_wayland|kwin_wayland_wr|plasmashell|ksmserver|kglobalacceld' >/dev/null 2>&1 || true
        sleep 1
    fi
    pkill -u "${uid}" -x Xwayland >/dev/null 2>&1 || true
}

start_plasma() {
    # Start the normal Plasma session exactly the way the login screen would
    local line=""
    if [ -f /usr/share/wayland-sessions/plasma.desktop ]; then
        line="$(grep -m1 '^Exec=' /usr/share/wayland-sessions/plasma.desktop | cut -d= -f2-)"
    fi
    [ -n "${line}" ] || line="/usr/bin/startplasma-wayland"
    # Plasma's own keyboard shortcuts and hot corners back (see kos-shortcuts)
    /usr/libexec/kos-shortcuts restore >> "${LOG}" 2>&1 || true
    # K.OS Console window rules off on the desktop (normal Alt+Tab, normal windows)
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kwinrc --group Plugins --key kos-consoleEnabled false || true
    fi
    # Desktop mode is for this login only: next login or restart is K.OS again
    rm -f "${MARK}"
    stop_leftovers
    clean_env
    # Remember when Plasma was started (restart-loop guard below)
    echo "$(date +%s) $(head -n 2 "${PLASMA_STARTS}" 2>/dev/null | tr '\n' ' ')" | tr ' ' '\n' | grep -v '^$' | head -n 3 > "${PLASMA_STARTS}.tmp" && mv -f "${PLASMA_STARTS}.tmp" "${PLASMA_STARTS}"
    log "starting Plasma desktop: ${line}"
    exec /bin/sh -c "${line}"
}

# Safety net for the developer desktop: if Plasma was started 3 times within
# 2 minutes, it keeps failing. Go back to the K.OS console instead of looping.
if [ -f "${MARK}" ] && [ -f "${PLASMA_STARTS}" ]; then
    oldest="$(tail -n 1 "${PLASMA_STARTS}")"
    count="$(wc -l < "${PLASMA_STARTS}")"
    if [ "${count}" -ge 3 ] && [ $(( $(date +%s) - ${oldest:-0} )) -lt 120 ]; then
        log "Plasma keeps failing to start, back to the K.OS console (desktop mode file removed)"
        rm -f "${MARK}" "${PLASMA_STARTS}"
    fi
fi

if [ -f "${MARK}" ]; then
    log "desktop mode file found"
    start_plasma
fi

fails="$(cat "${FAILS_FILE}" 2>/dev/null || echo 0)"
case "${fails}" in ''|*[!0-9]*) fails=0 ;; esac
if [ "${fails}" -ge 3 ]; then
    log "K.OS session failed ${fails} times in a row, using Plasma for this login"
    echo 0 > "${FAILS_FILE}"
    start_plasma
fi

# Session bus (normally already provided by the system)
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -z "${KOS_DBUS_STARTED:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    export KOS_DBUS_STARTED=1
    exec dbus-run-session -- "$0" "$@"
fi

# Language: the language chosen in KDE settings, else the system language
plasma_value() {
    # $1 group, $2 key
    awk -F= -v g="[$1]" -v k="$2" '$0 == g { s = 1; next } /^\[/ { s = 0 } s && $1 == k { print substr($0, length(k) + 2); exit }' \
        "${HOME}/.config/plasma-localerc" 2>/dev/null
}
if [ -f /etc/locale.conf ] && [ -z "${LANG:-}" ]; then
    # shellcheck disable=SC1091
    . /etc/locale.conf
fi
v="$(plasma_value Formats LANG)";        [ -n "${v}" ] && LANG="${v}"
v="$(plasma_value Translations LANGUAGE)"; [ -n "${v}" ] && LANGUAGE="${v}"
export LANG="${LANG:-tr_TR.UTF-8}"
[ -n "${LANGUAGE:-}" ] && export LANGUAGE

# Keyboard layout for the console. On the desktop, Plasma applies the layout
# itself; KWin alone (the K.OS session) does not, and fell back to US English.
# Order: the layout chosen in KDE settings, else the system keyboard, else
# Turkish Q (K.'s default).
kxkb_value() {
    awk -F= -v k="$1" '$0 == "[Layout]" { s = 1; next } /^\[/ { s = 0 } s && $1 == k { print substr($0, length(k) + 2); exit }' \
        "${HOME}/.config/kxkbrc" 2>/dev/null
}
layout="$(kxkb_value LayoutList | cut -d, -f1)"
variant="$(kxkb_value VariantList | cut -d, -f1)"
if [ -z "${layout}" ] && command -v localectl >/dev/null 2>&1; then
    layout="$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/ { print $2; exit }' | cut -d, -f1)"
    variant="$(localectl status 2>/dev/null | awk -F': ' '/X11 Variant/ { print $2; exit }' | cut -d, -f1)"
fi
export XKB_DEFAULT_LAYOUT="${layout:-tr}"
if [ -n "${variant}" ]; then export XKB_DEFAULT_VARIANT="${variant}"; else unset XKB_DEFAULT_VARIANT; fi

# K.OS Console window rules write what they do to this log (kos-diag shows it)
export QT_LOGGING_RULES="${QT_LOGGING_RULES:+${QT_LOGGING_RULES};}kwin_scripting.debug=true"

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export KDE_SESSION_VERSION=6
export KOS_SESSION=1

stop_leftovers

KWIN="kwin_wayland_wrapper"
command -v "${KWIN}" >/dev/null 2>&1 || KWIN="kwin_wayland"

# Console shortcuts only: Alt+Tab, Alt+Shift+Tab, Alt+F4 (K.OS Home refuses to
# close). No Meta key menu, no overview, no program shortcuts, no hot corners.
/usr/libexec/kos-shortcuts apply >> "${LOG}" 2>&1 || true
# K.OS Console window rules on (only in the console, see start_plasma)
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kwinrc --group Plugins --key kos-consoleEnabled true || true
fi

# --xwayland             : games and Steam that still use X11 work
# --no-lockscreen        : a console never shows a lock screen
# --exit-with-session    : the session lasts as long as kos-shell (K.OS Home) runs
log "starting K.OS session (${KWIN}, LANG=${LANG}, keyboard ${XKB_DEFAULT_LAYOUT}${XKB_DEFAULT_VARIANT:+/${XKB_DEFAULT_VARIANT}})"
started=$(date +%s)
"${KWIN}" --xwayland --no-lockscreen \
    --exit-with-session=/usr/libexec/kos-shell >> "${LOG}" 2>&1
code=$?
ran=$(( $(date +%s) - started ))
log "K.OS session ended after ${ran}s (exit code ${code})"

if [ "${ran}" -lt 20 ] && [ ! -f "${MARK}" ]; then
    echo $(( fails + 1 )) > "${FAILS_FILE}"
else
    echo 0 > "${FAILS_FILE}"
fi

# Desktop mode was chosen inside K.OS Home: end this login. The login
# screen logs in again by itself (Relogin=true) and this script then starts
# Plasma in a fresh, clean login (starting it here, in the same login right
# after KWin, left a half-dead screen behind: black monitor).
if [ -f "${MARK}" ]; then
    log "desktop mode chosen: ending this login, the next one opens Plasma"
fi

exit "${code}"
