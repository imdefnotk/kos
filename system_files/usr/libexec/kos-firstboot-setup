#!/usr/bin/env bash
# K.OS per-user setup. Despite the old name it now runs at EVERY login and is safe
# to run again and again: it simply rewrites the K.OS launchers and settings, so
# fixes in new K.OS updates reach your account automatically.
set -uo pipefail

KOS_SESSION_MODE="nvidia-desktop"
if [ -f /usr/share/kos/kos-release ]; then
    # shellcheck disable=SC1091
    . /usr/share/kos/kos-release
fi

APPS_DIR="${HOME}/.local/share/applications"
AUTOSTART_DIR="${HOME}/.config/autostart"
mkdir -p "${APPS_DIR}" "${AUTOSTART_DIR}"

# Remove leftovers from the first K.OS version
rm -f "${AUTOSTART_DIR}/kos-steam-bigpicture.desktop"
rm -f "${HOME}/.config/kos-initialized"

write_launcher() {
    # $1 file name, $2 display name, $3 command, $4 icon, $5 categories
    cat > "${APPS_DIR}/$1" << EOF
[Desktop Entry]
Type=Application
Name=$2
Exec=$3
Icon=$4
Terminal=false
Categories=$5
EOF
}

write_launcher kos-windows.desktop  "Switch to Windows" "/usr/bin/kos-boot-windows" "computer" "System;"
write_launcher kos-gamepass.desktop "Xbox Game Pass"    "/usr/bin/kos-webapp app https://www.xbox.com/play gamepass" "input-gaming" "Game;"
write_launcher kos-netflix.desktop  "Netflix"           "/usr/bin/kos-webapp app https://www.netflix.com netflix" "video-television" "AudioVideo;"
write_launcher kos-hbo.desktop      "HBO Max"           "/usr/bin/kos-webapp app https://www.hbomax.com hbomax" "video-television" "AudioVideo;"
write_launcher kos-browser.desktop  "Web Browser"       "/usr/bin/kos-webapp browser https://www.google.com browser" "web-browser" "Network;WebBrowser;"

if [ "${KOS_SESSION_MODE}" = "nvidia-desktop" ]; then
    # Only K.OS should start Steam at login. This hides any other Steam
    # autostart entry so Steam is not started twice.
    cat > "${AUTOSTART_DIR}/steam.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Steam
Exec=steam -silent
Hidden=true
EOF

    # A console should never show a lock screen asking for a password
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false
    fi
fi

exit 0
