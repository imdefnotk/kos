#!/usr/bin/env bash
# K.OS per-user setup. Despite the old name it now runs at EVERY login and is safe
# to run again and again: it simply rewrites the K.OS launchers and settings, so
# fixes in new K.OS updates reach your account automatically.
set -uo pipefail

KOS_SESSION_MODE="nvidia-desktop"
if [ -f /usr/share/kos/kos-release ]; then
    # shellcheck disable=SC1091
    . /usr/share/kos/kos-release
fi

APPS_DIR="${HOME}/.local/share/applications"
AUTOSTART_DIR="${HOME}/.config/autostart"
mkdir -p "${APPS_DIR}" "${AUTOSTART_DIR}"

# Remove leftovers from the first K.OS version
rm -f "${AUTOSTART_DIR}/kos-steam-bigpicture.desktop"
rm -f "${HOME}/.config/kos-initialized"

ART=/usr/share/kos/artwork

write_launcher() {
    # $1 file name, $2 display name, $3 command, $4 icon, $5 categories
    cat > "${APPS_DIR}/$1" << EOF
[Desktop Entry]
Type=Application
Name=$2
Exec=$3
Icon=$4
Terminal=false
Categories=$5
EOF
}

# Only offer "Switch to Windows" when this console has Windows
if efibootmgr 2>/dev/null | grep -qi "Windows Boot Manager"; then
    write_launcher kos-windows.desktop "Windows'a Geç" "/usr/bin/kos-boot-windows" "${ART}/windows/icon.png" "System;"
else
    rm -f "${APPS_DIR}/kos-windows.desktop"
fi
write_launcher kos-gamepass.desktop "Xbox Bulut Oyun" "/usr/bin/kos-webapp app https://www.xbox.com/play gamepass" "${ART}/xcloud/icon.png" "Game;"
write_launcher kos-netflix.desktop  "Netflix"         "/usr/bin/kos-webapp app https://www.netflix.com netflix" "${ART}/netflix/icon.png" "AudioVideo;"
write_launcher kos-hbo.desktop      "HBO Max"         "/usr/bin/kos-webapp app https://www.hbomax.com hbomax" "${ART}/hbomax/icon.png" "AudioVideo;"
write_launcher kos-browser.desktop  "İnternet"        "/usr/bin/kos-webapp browser https://www.google.com browser" "${ART}/browser/icon.png" "Network;WebBrowser;"

if [ "${KOS_SESSION_MODE}" = "nvidia-desktop" ]; then
    # Only K.OS should start Steam at login. This hides any other Steam
    # autostart entry so Steam is not started twice.
    cat > "${AUTOSTART_DIR}/steam.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Steam
Exec=steam -silent
Hidden=true
EOF

    # A console should never show a lock screen asking for a password
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false

        # K.OS Console window rules: while K.OS Home is open, games open full screen,
        # on the K.OS Home screen, in front (/usr/share/kwin/scripts/kos-console)
        kwriteconfig6 --file kwinrc --group Plugins --key kos-consoleEnabled true
        dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
    fi

    # One screen, like a console (both monitors only on Windows)
    /usr/libexec/kos-single-display || true

    # K.OS wallpaper, set at every login (the desktop should always look like K.OS)
    KOS_WALLPAPER=/usr/share/wallpapers/KOS/contents/images/3840x2160.png
    if [ -f "${KOS_WALLPAPER}" ] && command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        plasma-apply-wallpaperimage "${KOS_WALLPAPER}" >/dev/null 2>&1 || true
    fi
fi

exit 0
