#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""
K.OS uses one screen, like a game console. Both monitors are only for Windows.

Keeps the main display on (the one KDE marks as primary, priority 1) and
turns every other connected display off. Runs at login and when K.OS Home opens.
Safe to run again and again: if only one display is on, it does nothing.

Only acts inside the K.OS session (KOS_SESSION=1). The displays it turns off
are written down, and the developer Plasma desktop turns them back on at login:
  kos-single-display --restore
Check what it would do without changing anything:  kos-single-display --dry-run
"""

import json
import os
import shutil
import subprocess
import sys


def outputs():
    out = subprocess.run(["kscreen-doctor", "--json"], capture_output=True, text=True, timeout=10)
    data = json.loads(out.stdout or "{}")
    return [o for o in data.get("outputs", []) if o.get("connected")]


def area(o):
    for m in o.get("modes", []):
        if str(m.get("id")) == str(o.get("currentModeId")):
            size = m.get("size") or {}
            return size.get("width", 0) * size.get("height", 0)
    return 0


OFF_LIST = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                        "kos", "displays-off")


def restore():
    """Plasma desktop: turn back on the displays the K.OS session turned off."""
    try:
        with open(OFF_LIST, "r", encoding="utf-8") as f:
            names = [n.strip() for n in f if n.strip()]
    except OSError:
        return 0
    if names and shutil.which("kscreen-doctor"):
        print("turning back on: %s" % ", ".join(names))
        subprocess.run(["kscreen-doctor"] + ["output.%s.enable" % n for n in names], timeout=20)
    try:
        os.remove(OFF_LIST)
    except OSError:
        pass
    return 0


def main():
    dry = "--dry-run" in sys.argv
    if "--restore" in sys.argv:
        return restore()
    if os.environ.get("KOS_SESSION") != "1" and not dry:
        return 0
    if not shutil.which("kscreen-doctor"):
        print("kscreen-doctor not found", file=sys.stderr)
        return 0
    try:
        outs = outputs()
    except (OSError, ValueError, subprocess.SubprocessError) as err:
        print("cannot read displays: %s" % err, file=sys.stderr)
        return 0
    enabled = [o for o in outs if o.get("enabled")]
    if len(enabled) <= 1:
        print("one display on: nothing to do")
        return 0

    # Main display: KDE primary (priority 1), else the biggest one
    def rank(o):
        prio = o.get("priority") or 99
        return (prio, -area(o))
    keep = sorted(enabled, key=rank)[0]
    others = [o for o in enabled if o is not keep]
    print("keeping: %s" % keep.get("name"))
    args = ["kscreen-doctor"] + ["output.%s.disable" % o.get("name") for o in others]
    print("turning off: %s" % ", ".join(o.get("name", "?") for o in others))
    if not dry:
        try:
            os.makedirs(os.path.dirname(OFF_LIST), exist_ok=True)
            old = set()
            if os.path.exists(OFF_LIST):
                with open(OFF_LIST, "r", encoding="utf-8") as f:
                    old = {n.strip() for n in f if n.strip()}
            with open(OFF_LIST, "w", encoding="utf-8") as f:
                f.write("\n".join(sorted(old | {o.get("name") for o in others if o.get("name")})) + "\n")
        except OSError:
            pass
        subprocess.run(args, timeout=20)
    return 0


if __name__ == "__main__":
    sys.exit(main())
