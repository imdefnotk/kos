# Keep Linux line endings (LF) for every text file, even when edited on Windows.
# Scripts with Windows line endings (CRLF) break on K.OS.
* text=auto eol=lf

# Windows command files need Windows line endings
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.webm binary
*.mp4 binary
*.ttf binary
*.otf binary
*.ico binary
